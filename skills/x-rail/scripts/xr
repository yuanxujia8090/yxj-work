#!/usr/bin/env python3
"""xr：v3 run 的记账命令。状态只写在 .work-docs/runs，模型不直接改 TSV。"""
from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
import re
import shlex
import subprocess
import sys
import tempfile
from contextlib import contextmanager
from datetime import datetime
from pathlib import Path
from zoneinfo import ZoneInfo

sys.path.insert(0, str(Path(__file__).resolve().parent))
import frontier  # noqa: E402

TZ = ZoneInfo("Asia/Shanghai")
HEADER = ["id", "title", "state", "deps", "scope", "output_scope", "timebox_min", "attempts", "owner", "model", "verify_cmd", "verify_kind", "evidence", "updated", "kind"]
LEGACY_HEADER = ["id", "title", "state", "deps", "scope", "timebox_min", "attempts", "owner", "model", "verify_cmd", "evidence", "updated", "kind"]
COMMAND_LEDGER = ["unit", "tree_hash", "cmd_hash", "verdict", "cmd", "exit_code", "evidence_path", "report_hash", "model", "ts"]
LEDGER = COMMAND_LEDGER + ["evidence_kind", "observer", "session_path", "session_hash", "input_scope", "input_hash", "final_hash", "record"]
PREVIOUS_LEDGER = ["unit", "tree_hash", "cmd_hash", "verdict", "cmd", "exit_code", "evidence_path", "model", "ts"]
LEGACY_LEDGER = ["unit", "tree_hash", "verdict", "cmd", "exit_code", "evidence_path", "model", "ts"]
DECISIONS = ["ts", "unit", "decision", "reason", "alternatives", "reversible", "by_model"]
ID_RE = re.compile(r"[A-Za-z][A-Za-z0-9_-]*")
SLUG_RE = re.compile(r"[a-z0-9]+(?:-[a-z0-9]+)*")
KINDS = {"impl", "review", "research", "bugfix", "integration"}
ACCEPTANCE = ["id", "statement", "source", "units", "status"]
EXPLICIT_RUN_ID: str | None = None
CALLER_SESSION: str | None = None
CALLER_GENERATION: int | None = None
FAIL_KINDS = {"cap", "net", "tool", "logic", "verify", "unknown"}
WRITERS = {"impl", "bugfix"}
TERMINAL = {"done", "abandoned"}


def now() -> datetime:
    return datetime.now(TZ)


def stamp(moment: datetime | None = None) -> str:
    return (moment or now()).isoformat(timespec="seconds")


def say(text: str) -> None:
    print(text)


def die(text: str) -> None:
    say(f"xr: {text}")
    raise SystemExit(2)


def repo_of(args: argparse.Namespace) -> Path:
    return Path(args.repo).resolve() if args.repo else Path.cwd().resolve()


def cell(value: str) -> str:
    if value is None or "\t" in value or "\n" in value or "\r" in value:
        die("字段不能包含制表符或换行")
    return value


def read_tsv(path: Path, header: list[str]) -> list[dict[str, str]]:
    if not path.is_file():
        return []
    lines = path.read_text().splitlines()
    if not lines:
        return []
    got = lines[0].split("\t")
    if got != header:
        die(f"{path.name} 表头不对。正确命令：不要手改 TSV，用 xr 动词重写")
    rows = []
    for line in lines[1:]:
        if not line.strip():
            continue
        parts = line.split("\t")
        if len(parts) != len(header):
            die(f"{path.name} 有一行字段数不对")
        rows.append(dict(zip(header, parts)))
    return rows


def atomic_write_text(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = None
    try:
        with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=path.parent, prefix=f".{path.name}.", suffix=".tmp", delete=False) as output:
            temporary = Path(output.name)
            output.write(text)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, path)
    finally:
        if temporary and temporary.exists():
            temporary.unlink()


def write_tsv(path: Path, header: list[str], rows: list[dict[str, str]]) -> None:
    body = ["\t".join(header)]
    for row in rows:
        body.append("\t".join(cell(row[key]) for key in header))
    atomic_write_text(path, "\n".join(body) + "\n")


@contextmanager
def run_lock(run: Path, *, validate: bool = True):
    lock_path = run / ".lock"
    with lock_path.open("a+") as handle:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        try:
            if validate:
                check_writer(run)
            yield
        finally:
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)


def check_writer(run: Path) -> None:
    global CALLER_GENERATION
    binding = read_binding(run)
    if not binding or binding.get("_invalid"):
        die("写入需要有效会话绑定；旧运行请先显式 bind")
    if binding.get("workspace") != str(run.parent.parent.parent.resolve()) or binding.get("run_id") != run.name:
        die("绑定与当前工作区或运行不一致")
    if not CALLER_SESSION or binding.get("session_id") != CALLER_SESSION:
        die("session 与当前绑定不一致，拒绝旧会话写入")
    generation = binding.get("generation")
    if not isinstance(generation, int) or generation < 1:
        die("绑定缺少 generation；请显式 bind 或接管旧运行")
    if CALLER_GENERATION is None:
        CALLER_GENERATION = generation
    if CALLER_GENERATION != generation:
        die("generation 已过期，拒绝延迟写入")
    if binding.get("lease") == "released":
        die("运行已释放，拒绝写入")


def append_event_record(run: Path, record: dict) -> None:
    with (run / "events.jsonl").open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(record, ensure_ascii=False) + "\n")
        handle.flush()
        os.fsync(handle.fileno())


def event(run: Path, payload: dict) -> None:
    binding = read_binding(run) or {}
    record = {"schema": 1, "event_id": os.urandom(16).hex(), "ts": stamp(),
              "workspace": str(run.parent.parent.parent.resolve()), "run_id": run.name,
              "session_id": binding.get("session_id"), "generation": binding.get("generation"),
              "detail": payload.copy(), **payload}
    append_event_record(run, record)


def event_ids(run: Path) -> set[str]:
    path = run / "events.jsonl"
    if not path.is_file():
        return set()
    found = set()
    for line in path.read_text().splitlines():
        if not line.strip():
            continue
        try:
            item = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(item, dict) and isinstance(item.get("event_id"), str):
            found.add(item["event_id"])
    return found


def cmd_event(args: argparse.Namespace) -> None:
    repo = repo_of(args)
    record_path = Path(args.record).resolve()
    if not record_path.is_file():
        die(f"找不到事件记录 {args.record}。正确命令：xr event --record <本进程私有临时文件>")
    try:
        record = json.loads(record_path.read_text())
    except (OSError, json.JSONDecodeError):
        die(f"事件记录不是合法 JSON：{args.record}")
    if not isinstance(record, dict):
        die("事件记录必须是 JSON 对象")
    event_id = record.get("event_id")
    if not isinstance(event_id, str) or not re.fullmatch(r"[A-Za-z0-9_-]{1,128}", event_id):
        die("事件记录缺 event_id（1-128 位字母数字或 _-）")
    if not isinstance(record.get("type"), str) or not record["type"]:
        die("事件记录缺 type")
    run = run_dir(repo, record.get("run_id"))
    with run_lock(run):
        binding = read_binding(run) or {}
        if record.get("workspace") != str(repo.resolve()) or record.get("run_id") != run.name:
            die("事件记录的 workspace 或 run 与当前运行不一致")
        if record.get("session_id") != binding.get("session_id"):
            die("事件记录的 session 与当前绑定不一致，拒绝旧会话写入")
        if record.get("generation") != binding.get("generation"):
            die("事件记录的 generation 已过期，拒绝延迟写入")
        if event_id in event_ids(run):
            say(f"ok event {event_id} duplicate")
            return
        detail = record.get("detail") if isinstance(record.get("detail"), dict) else {}
        if record["type"] == "worker_started":
            detail = prepare_worker(repo, run, detail)
        append_event_record(run, {**record, "schema": 1, "ts": stamp(), "detail": detail})
    say(f"ok event {event_id} {record['type']}")


def cmd_op_reconcile(args: argparse.Namespace) -> None:
    if args.resolution not in {"completed", "not-started", "failed"}:
        die("resolution 只能是 completed、not-started 或 failed")
    if not args.record:
        die("核实需要 --record 引用现场证据")
    run = run_dir(repo_of(args))
    with run_lock(run):
        pending, truncated = unresolved_ops(run)
        if truncated:
            die("事件日志损坏，无法核实动作；先修复 events.jsonl")
        if args.op not in pending:
            die(f"没有未决动作 {args.op}。正确命令：xr inspect --json 查看 unresolved_ops")
        event(run, {"type": "op_reconcile", "op_id": args.op, "resolution": args.resolution, "record": args.record})
    say(f"ok op {args.op} {args.resolution}")


RUN_ID_RE = re.compile(r"\d{8}-\d{4}-[a-z0-9]+(?:-[a-z0-9]+)*(?:-\d+)?")


def valid_run_id(value: str) -> bool:
    return bool(RUN_ID_RE.fullmatch(value))


def active_id(repo: Path) -> str:
    pointer = repo / ".work-docs" / "runs" / "ACTIVE"
    if not pointer.is_file():
        die("没有 active run。正确命令：xr init <slug>")
    name = pointer.read_text().strip()
    if not valid_run_id(name):
        die(f"ACTIVE 中的 run id 不合法：{name}。只能使用 xr init 生成的 run")
    return name


def run_dir(repo: Path, run_id: str | None = None) -> Path:
    base = (repo / ".work-docs" / "runs").resolve()
    if run_id is None:
        run_id = EXPLICIT_RUN_ID
    name = run_id if run_id is not None else active_id(repo)
    if not valid_run_id(name):
        die(f"run id 不合法：{name}")
    path = (base / name).resolve()
    try:
        path.relative_to(base)
    except ValueError:
        die(f"run 路径越界：{name}")
    if not (path / "RUN.md").is_file():
        die(f"找不到 run {name}。正确命令：xr init <slug>")
    return path


def units(run: Path) -> list[dict[str, str]]:
    path = run / "units.tsv"
    if not path.is_file() or not path.read_text().strip():
        return []
    header = path.read_text().splitlines()[0].split("\t")
    if header == HEADER:
        return read_tsv(path, HEADER)
    previous = [key for key in HEADER if key != "verify_kind"]
    if header == previous:
        return [{**row, "verify_kind": "command"} for row in read_tsv(path, previous)]
    if header != LEGACY_HEADER:
        die("units.tsv 表头不对。正确命令：不要手改 TSV，用 xr 命令重写")
    return [{**row, "output_scope": row["scope"], "verify_kind": "command"} for row in read_tsv(path, LEGACY_HEADER)]


def save_units(run: Path, rows: list[dict[str, str]]) -> None:
    write_tsv(run / "units.tsv", HEADER, rows)


def find_unit(rows: list[dict[str, str]], unit_id: str) -> dict[str, str]:
    for row in rows:
        if row["id"] == unit_id:
            return row
    die(f"没有单元 {unit_id}。正确命令：xr plan add {unit_id} \"标题\" --deps none --files <路径> --verify \"<命令>\"")
    raise AssertionError


def check_scope(scope: str) -> list[str]:
    parts = [part.strip() for part in scope.split(",") if part.strip()]
    if not parts:
        die("缺少独占文件集。正确命令：xr plan add <id> \"标题\" --deps none --files <路径> --verify \"<命令>\"")
    for part in parts:
        try:
            frontier.scope_parts(part)
        except ValueError as error:
            die(f"{error}。正确命令：--files 使用仓库内相对路径，不要写 .. 或绝对路径")
    return parts


def cycles(rows: list[dict[str, str]]) -> bool:
    graph = {row["id"]: [item for item in row["deps"].split(",") if item and item != "none"] for row in rows}
    seen: set[str] = set()
    stack: set[str] = set()

    def walk(name: str) -> bool:
        if name in stack:
            return True
        if name in seen:
            return False
        stack.add(name)
        for dep in graph.get(name, []):
            if dep not in graph or walk(dep):
                return True
        stack.remove(name)
        seen.add(name)
        return False

    return any(walk(name) for name in graph)


def limits() -> tuple[int, int, int]:
    return 5, 2, 5


def is_writer(kind: str) -> bool:
    return kind in WRITERS


def tree_hash(repo: Path, scope: str) -> str:
    digest = hashlib.sha256()
    files: list[Path] = []
    root = repo.resolve()
    for pattern in check_scope(scope):
        if any(char in pattern for char in "*?["):
            files.extend(path for path in repo.glob(pattern) if path.is_file())
        else:
            candidate = repo / pattern
            if candidate.is_file():
                files.append(candidate)
            elif candidate.is_dir():
                files.extend(path for path in candidate.rglob("*") if path.is_file())
    resolved_files: list[Path] = []
    for item in sorted({path.resolve() for path in files}):
        try:
            item.relative_to(root)
        except ValueError:
            die(f"scope 通过软链越出仓库：{item}")
        resolved_files.append(item)
    if not resolved_files:
        die(f"scope 没有匹配文件：{scope}。不能生成 VERIFIED 证据")
    for path in resolved_files:
        rel = path.relative_to(root).as_posix()
        digest.update(rel.encode())
        digest.update(b"\0")
        digest.update(path.read_bytes())
        digest.update(b"\0")
    return digest.hexdigest()[:16]


def verification_hash(repo: Path, row: dict[str, str]) -> str:
    scope = row["scope"]
    output_scope = row.get("output_scope", scope)
    if output_scope != "none":
        scope = f"{scope},{output_scope}"
    return tree_hash(repo, scope)


def command_hash(command: str) -> str:
    return hashlib.sha256(command.encode()).hexdigest()[:16]


def model_of(run: Path) -> str:
    for line in (run / "RUN.md").read_text().splitlines():
        if line.startswith("model:"):
            return line.split(":", 1)[1].strip() or "unknown"
    return "unknown"


def mode_of(run: Path, rows: list[dict[str, str]]) -> str:
    text = (run / "RUN.md").read_text()
    match = re.search(r"^mode:\s*(\S+)", text, re.M)
    chosen = match.group(1) if match else "auto"
    if chosen in {"main", "subagents"}:
        return chosen
    return "subagents" if len(rows) >= 5 else "main"


def replace_block(text: str, start: str, end: str, body: str) -> str:
    block = f"{start}\n{body.rstrip()}\n{end}"
    pattern = re.compile(re.escape(start) + r".*?" + re.escape(end), re.S)
    if pattern.search(text):
        return pattern.sub(block, text, count=1)
    return text.rstrip() + "\n\n" + block + "\n"


def preflight(repo: Path) -> str:
    lines = [f"- python3: {sys.version.split()[0]}"]
    if not shutil_which("git"):
        lines.append("- git: 未安装")
    else:
        probe = subprocess.run(["git", "-C", str(repo), "rev-parse", "--is-inside-work-tree"], capture_output=True, text=True)
        if probe.returncode != 0:
            lines.append("- git: 当前目录不是仓库")
        else:
            branch = subprocess.run(["git", "-C", str(repo), "branch", "--show-current"], capture_output=True, text=True)
            lines.append(f"- git: 分支 {branch.stdout.strip() or 'detached'}")
    lines.append(f"- 写入路径: {repo} 下的 .work-docs/runs")
    lines.append("- context-mode: xr 不探测；curl 被拦截时把事实写入 events.jsonl")
    lines.append("- apply_patch: 由宿主提供，xr 不代查")
    for skill in ("x-handoff", "x-worktree", "x-self-check"):
        present = (repo / "skills" / skill / "SKILL.md").is_file()
        lines.append(f"- 技能 {skill}: {'仓库内存在' if present else '未在当前仓库'}")
    check = (repo / "scripts" / "check-repo.sh").is_file()
    lines.append(f"- 检查命令: {'scripts/check-repo.sh 存在' if check else '未发现 scripts/check-repo.sh'}")
    lines.append("- 默认允许在 run 分支或 worktree 上做本地 wip 提交，不推送。")
    return "\n".join(lines)


def shutil_which(name: str) -> str | None:
    from shutil import which
    return which(name)


def skeleton(run_id: str, pre: str) -> str:
    return f"""# Run {run_id}

model: unknown
failback: auto
mode: auto
format_version: 2
dispatch_epoch: 0
phase: executing
review_required: false

## Intent

（Frame 阶段写一句话目标）

## Done

（写可数、可检查的完成判据）

## Standing orders

1. 允许在 run 分支或 worktree 上做本地 wip 提交，不推送。
2. 删除数据、强推、生产数据库迁移、花钱、对外发布、范围变更必须先问。

## Autonomy

<!-- xr:preflight:start -->
{pre}
<!-- xr:preflight:end -->

## Budgets

- wall: 未填
- cost: 未填
- unit: 由宿主实际运行限制决定

## Status

<!-- xr:status:start -->
idle
<!-- xr:status:end -->

## Acceptance

## Risks

- none
"""


def cmd_init(args: argparse.Namespace) -> None:
    slug = args.slug
    if not SLUG_RE.fullmatch(slug) or len(slug) > 40:
        die("slug 只能用小写字母、数字和短横线。正确命令：xr init my-task")
    repo = repo_of(args)
    session = current_session(args)
    if not session:
        if not getattr(args, "offline", False):
            die("缺少 session；使用 --session、PI_SESSION_ID、XR_SESSION，人工离线记录需显式 --offline")
        session = "local"
    base = repo / ".work-docs" / "runs"
    base.mkdir(parents=True, exist_ok=True)
    with (base / ".init.lock").open("a+") as init_lock:
        fcntl.flock(init_lock.fileno(), fcntl.LOCK_EX)
        active = base / "ACTIVE"
        if active.is_file():
            die(f"已有 active run {active.read_text().strip()}；先关闭或恢复该运行")
        run_id = f"{now().strftime('%Y%m%d-%H%M')}-{slug}"
        suffix = 2
        path = base / run_id
        while path.exists():
            path = base / f"{run_id}-{suffix}"
            suffix += 1
            run_id = path.name
        path.mkdir()
        (path / "notes").mkdir()
        (path / "RUN.md").write_text(skeleton(run_id, preflight(repo)))
        write_tsv(path / "units.tsv", HEADER, [])
        write_tsv(path / "ledger.tsv", LEDGER, [])
        write_tsv(path / "decisions.tsv", DECISIONS, [])
        (path / "gates.md").write_text("# gates\n\n")
        (path / "events.jsonl").write_text("")
        (path / "capsule.md").write_text("")
        write_tsv(path / "acceptance.tsv", ACCEPTANCE, [])
        atomic_write_text(path / "binding.json", json.dumps({
            "schema": 1, "workspace": str(repo.resolve()), "run_id": run_id,
            "session_id": session, "generation": 1, "owner": "host",
            "created_at": stamp(), "lease": "active",
        }, ensure_ascii=False, indent=2) + "\n")
        atomic_write_text(active, run_id + "\n")
        event(path, {"type": "init", "run": run_id, "session_id": session, "generation": 1})
    say(f"ok init {run_id}")


def cmd_plan_add(args: argparse.Namespace) -> None:
    if not ID_RE.fullmatch(args.id):
        die(f"单元 id 不合法。正确命令：xr plan add {args.id or 'ID'} \"标题\" --deps none --files <路径> --verify \"<命令>\"")
    if not args.title or not args.files or not args.deps:
        die("参数不够。正确命令：xr plan add <id> \"标题\" --deps none --files <路径> [--verify \"<命令>\"]")
    verify_kind = args.verify_kind or "command"
    if verify_kind not in {"command", "observation", "review"}:
        die("verify-kind 只能是 command、observation、review")
    if verify_kind == "command" and not args.verify:
        die("command 验收必须提供 --verify；人工验收请用 --verify-kind observation|review")
    kind = args.kind or "impl"
    if kind not in KINDS:
        die("kind 只能是 impl、review、research、bugfix、integration。正确命令：xr plan add <id> \"标题\" --deps none --files <路径> --verify \"<命令>\" --kind impl")
    check_scope(args.files)
    deps = "none" if args.deps.strip() == "none" else ",".join(part.strip() for part in args.deps.split(",") if part.strip())
    repo = repo_of(args)
    run = run_dir(repo)
    with run_lock(run):
        rows = units(run)
        known = {row["id"] for row in rows}
        if deps != "none":
            missing = [item for item in deps.split(",") if item not in known and item != args.id]
            if missing:
                die(f"依赖还不存在：{','.join(missing)}。正确命令：先 xr plan add 依赖，再加这个单元")
        timebox = str(args.timebox if args.timebox is not None else (25 if kind == "review" else 15 if kind == "research" else 45))
        output_scope = args.output_scope or (args.files if is_writer(kind) else "none")
        if output_scope != "none":
            check_scope(output_scope)
        fresh = {
            "id": args.id, "title": cell(args.title), "state": "todo", "deps": deps, "scope": args.files,
            "output_scope": output_scope, "timebox_min": timebox, "attempts": "0", "owner": "unassigned", "model": model_of(run),
            "verify_cmd": cell(args.verify or ""), "verify_kind": verify_kind, "evidence": "none", "updated": stamp(), "kind": kind,
        }
        replaced = False
        for index, row in enumerate(rows):
            if row["id"] == args.id:
                if row["state"] in TERMINAL:
                    die(f"单元 {args.id} 已终态 {row['state']}，先执行 xr reopen {args.id}")
                if row["state"] not in {"todo", "failed"}:
                    die(f"单元 {args.id} 正在 {row['state']}，不能改。正确命令：xr status")
                fresh["attempts"] = row["attempts"]
                fresh["evidence"] = row["evidence"]
                rows[index] = fresh
                replaced = True
        if not replaced:
            rows.append(fresh)
        if cycles(rows):
            die("依赖有环，已拒绝。正确命令：xr plan add <id> \"标题\" --deps none --files <路径> --verify \"<命令>\"")
        save_units(run, rows)
        if len(rows) >= 5 and mode_of(run, rows) == "subagents":
            record_decision(run, "mode", "不少于 5 个单元，走子代理", "主会话执行", "Y")
        event(run, {"type": "plan", "unit": args.id, "replaced": replaced})
    say(f"ok plan {args.id} {'updated' if replaced else 'added'} units={len(rows)} mode={mode_of(run, rows)}")


def ready(repo: Path, run: Path, row: dict[str, str], rows: list[dict[str, str]]) -> bool:
    if row["state"] != "todo":
        return False
    if row["deps"] == "none":
        return True
    by_id = {item["id"]: item for item in rows}
    dependencies = [by_id.get(dep) for dep in row["deps"].split(",") if dep]
    return all(item is not None and item["state"] == "done" and try_verified(repo, run, item) for item in dependencies)


def path_sets(row: dict[str, str]) -> tuple[list[str], list[str]]:
    inputs = [part.strip() for part in row["scope"].split(",") if part.strip()]
    outputs = [part.strip() for part in row.get("output_scope", row["scope"]).split(",") if part.strip() and part.strip() != "none"]
    return inputs, outputs


def overlaps(row: dict[str, str], other: dict[str, str]) -> bool:
    left_inputs, left_outputs = path_sets(row)
    right_inputs, right_outputs = path_sets(other)
    return (any(frontier.overlap(a, b) for a in left_outputs for b in right_inputs + right_outputs)
            or any(frontier.overlap(a, b) for a in left_inputs for b in right_outputs))


def cmd_next(args: argparse.Namespace) -> None:
    run = run_dir(repo_of(args))
    with run_lock(run):
        ensure_consistent(run)
        blocked = automation_blocked(run)
        if blocked:
            say(f"ok next none {blocked}")
            return
        rows = units(run)
        readers, writers, total = limits()
        doing = [row for row in rows if row["state"] == "doing"]
        held = [row for row in rows if row["state"] == "blocked" and
                (";kind:" in row["evidence"] or "blocked_from:doing" in row["evidence"])]
        occupied = doing + held
        if len(occupied) >= total:
            say("ok next none concurrency")
            return
        for row in rows:
            if not ready(repo_of(args), run, row, rows):
                continue
            if any(overlaps(row, other) for other in occupied):
                continue
            writer = is_writer(row["kind"])
            if writer and sum(1 for item in occupied if is_writer(item["kind"])) >= writers:
                continue
            if not writer and sum(1 for item in occupied if not is_writer(item["kind"])) >= readers:
                continue
            row["state"] = "doing"
            row["updated"] = stamp()
            save_units(run, rows)
            event(run, {"type": "next", "unit": row["id"]})
            say(f"ok next {row['id']} doing")
            return
    say("ok next none")


def ledger_rows(run: Path) -> list[dict[str, str]]:
    path = run / "ledger.tsv"
    if not path.is_file() or not path.read_text().strip():
        return []
    first = path.read_text().splitlines()[0].split("\t")
    if first == LEDGER:
        return read_tsv(path, LEDGER)
    if first not in (COMMAND_LEDGER, PREVIOUS_LEDGER, LEGACY_LEDGER):
        die("ledger.tsv 表头不对。正确命令：不要手改 TSV，用 xr verify 重建")
    return [{**{key: "" for key in LEDGER}, **row,
             "cmd_hash": row.get("cmd_hash", command_hash(row["cmd"])), "evidence_kind": "command"}
            for row in read_tsv(path, first)]


def cmd_evidence(args: argparse.Namespace) -> None:
    repo = repo_of(args)
    run = run_dir(repo)
    if args.kind not in {"observation", "review"} or not args.record:
        die("人工证据需要 --kind observation|review 和 --record 引用")
    with run_lock(run):
        row = find_unit(units(run), args.id)
        if row.get("verify_kind", "command") != args.kind:
            die("证据类型与单元 verify-kind 不一致")
        require_settled(run, args.id)
        if row["state"] in {"todo", "blocked", "abandoned"}:
            die("人工证据只能登记到已开工单元；先 xr next 或 reopen")
        input_scope = args.inputs or row["scope"]
        input_hash = tree_hash(repo, input_scope)
        digest = verification_hash(repo, row)
        final_hash = review_input_hash(repo, run) if args.kind == "review" else digest
        report = (repo / args.report).resolve()
        try:
            report.relative_to(repo.resolve())
        except ValueError:
            die("报告必须位于当前仓库内")
        try:
            report.relative_to(run.resolve())
            die("运行目录中的原始文件不能直接作为报告；请放到仓库或由 xr 保存到 notes")
        except ValueError:
            pass
        if not report.is_file() or not report.read_text(encoding="utf-8").strip():
            die("报告不存在或为空")
        existing = ledger_rows(run)
        if verified_now(repo, run, row):
            die("该版本已有有效证据，不覆盖旧报告")
        cell(args.record)
        observer_session, observer_digest, observer_path = "", "", ""
        if args.kind == "review":
            if not args.observer:
                die("review 必须提供 --observer <独立审查会话文件>")
            observer = (repo / args.observer).resolve()
            try:
                transcript = observer.read_text(encoding="utf-8")
                records = [json.loads(line) for line in transcript.splitlines() if line.strip()]
                first = records[0]
                observer_session = first.get("id")
                if first.get("type") != "session" or not isinstance(observer_session, str) or not observer_session.strip():
                    die("独立审查会话头无效")
                if Path(first.get("cwd", "")).resolve() != repo:
                    die("审查会话不属于当前工作区")
                if observer_session in implementation_sessions(run):
                    die("实现会话不能作为独立审查会话")
                texts = [part.get("text", "") for entry in records if entry.get("type") == "message"
                         and isinstance(entry.get("message"), dict) and entry["message"].get("role") == "assistant"
                         and isinstance(entry["message"].get("content"), list)
                         for part in entry["message"]["content"] if isinstance(part, dict) and part.get("type") == "text"]
                if not any(report.read_text(encoding="utf-8").strip() in text for text in texts):
                    die("审查报告内容与所给审查会话的实际输出不匹配")
                observer_saved = run / "notes" / f"review-session-{args.id}-{len(existing) + 1}.jsonl"
                with observer_saved.open("x", encoding="utf-8") as output:
                    output.write(transcript)
                    output.flush()
                    os.fsync(output.fileno())
                observer_path = observer_saved.relative_to(run).as_posix()
                observer_digest = file_digest(observer_saved)
            except (OSError, IndexError, ValueError, KeyError, TypeError, AttributeError):
                die("独立审查会话无效或证据目标已存在")
        saved = run / "notes" / f"evidence-{args.id}-{args.kind}-{len(existing) + 1}.md"
        try:
            with saved.open("x", encoding="utf-8") as output:
                output.write(report.read_text(encoding="utf-8"))
                output.flush()
                os.fsync(output.fileno())
        except OSError:
            die("报告保存失败或目标已存在，保留旧文件")
        item = {**{key: "" for key in LEDGER}, "unit": args.id, "tree_hash": digest,
                "cmd_hash": command_hash(input_scope), "verdict": "VERIFIED", "cmd": input_scope, "exit_code": "0",
                "evidence_path": saved.relative_to(run).as_posix(), "report_hash": hashlib.sha256(saved.read_bytes()).hexdigest(),
                "model": model_of(run), "ts": stamp(), "evidence_kind": args.kind,
                "observer": observer_session, "session_path": observer_path, "session_hash": observer_digest,
                "input_scope": input_scope, "input_hash": input_hash, "final_hash": final_hash, "record": cell(args.record)}
        existing.append(item)
        write_tsv(run / "ledger.tsv", LEDGER, existing)
        event(run, {"type": "evidence", "unit": args.id, "kind": args.kind, "report": item["evidence_path"]})
    say(f"ok evidence {args.id} {args.kind}")


def cmd_verify(args: argparse.Namespace) -> None:
    repo = repo_of(args)
    run = run_dir(repo)
    with run_lock(run):
        row = find_unit(units(run), args.id).copy()
        require_settled(run, args.id)
        digest = verification_hash(repo, row)
        command = row["verify_cmd"]
        if row.get("verify_kind", "command") != "command":
            die("该单元使用人工验收，请执行 xr evidence record")
        if verified_now(repo, run, row):
            say(f"ok verify {args.id} VERIFIED {digest} cached")
            return
    timeout = int(args.timeout) if args.timeout else 180
    try:
        result = subprocess.run(command, shell=True, cwd=repo, capture_output=True, text=True, timeout=timeout)
        code = result.returncode
        output = (result.stdout or "") + (result.stderr or "")
    except subprocess.TimeoutExpired as error:
        code = 124
        output = (error.stdout or "") if isinstance(error.stdout, str) else ""
    with run_lock(run):
        current_rows = units(run)
        current = find_unit(current_rows, args.id)
        current_digest = verification_hash(repo, current)
        if current["verify_cmd"] != command or current_digest != digest:
            code = 125
            output += "\n验证期间单元判据或文件已变化；本次证据作废，请重新 xr verify。\n"
        existing = ledger_rows(run)
        attempt = len(existing) + 1
        evidence = run / "notes" / f"verify-{args.id}-attempt-{attempt}.log"
        with evidence.open("x", encoding="utf-8") as report:
            report.write(output)
            report.flush()
            os.fsync(report.fileno())
        report_hash = hashlib.sha256(output.encode()).hexdigest()
        verdict = "VERIFIED" if code == 0 else "FAILED"
        existing.append({
            **{key: "" for key in LEDGER}, "evidence_kind": "command",
            "unit": args.id, "tree_hash": digest, "cmd_hash": command_hash(command), "verdict": verdict,
            "cmd": command.replace("\t", " "), "exit_code": str(code),
            "evidence_path": evidence.relative_to(run).as_posix(), "report_hash": report_hash,
            "model": current["model"] or model_of(run), "ts": stamp(),
        })
        write_tsv(run / "ledger.tsv", LEDGER, existing)
        if verdict == "VERIFIED" and current["state"] == "doing":
            current["state"] = "verifying"
            current["updated"] = stamp()
            save_units(run, current_rows)
        event(run, {"type": "verify", "unit": args.id, "verdict": verdict, "exit": code})
    say(f"ok verify {args.id} {verdict} {digest}")


def implementation_sessions(run: Path) -> set[str]:
    events, _ = read_events(run)
    sessions = {str((read_binding(run) or {}).get("session_id", ""))}
    for item in events:
        if item.get("session_id"):
            sessions.add(item["session_id"])
    # 接收的实现子会话也不能自审；只读 review 子任务保留独立身份。
    by_id = {row["id"]: row for row in units(run)}
    started, received = worker_records(run)
    for child, receipt in received.items():
        start = started.get(child, {})
        if by_id.get(start.get("unit"), {}).get("kind") == "review":
            continue
        try:
            saved = json.loads((run / receipt["path"]).read_text())
            sessions.update(saved["child_sessions"])
        except (OSError, ValueError, KeyError, TypeError):
            pass
    return sessions


def review_input_hash(repo: Path, run: Path) -> str:
    # 排除审查工作项自身，避免登记审查报告造成自我失效。
    parts = [{"id": row["id"], "kind": row["kind"], "deps": row["deps"], "scope": row["scope"],
              "output": row["output_scope"], "verify": row["verify_cmd"], "verify_kind": row.get("verify_kind", "command"),
              "digest": verification_hash(repo, row)} for row in units(run)
             if row["kind"] != "review" and row["state"] != "abandoned"]
    return hashlib.sha256((json.dumps(parts, sort_keys=True) + file_digest(run / "acceptance.tsv")).encode()).hexdigest()



def verified_now(repo: Path, run: Path, row: dict[str, str], visiting: frozenset[str] = frozenset()) -> bool:
    if row["id"] in visiting:
        return False
    visiting = visiting | {row["id"]}
    by_id = {item["id"]: item for item in units(run)}
    if row["deps"] != "none":
        for dep in row["deps"].split(","):
            previous = by_id.get(dep)
            if previous is None or previous["state"] != "done" or not verified_now(repo, run, previous, visiting):
                return False
    digest = verification_hash(repo, row)
    if row.get("verify_kind", "command") == "command":
        command = command_hash(row["verify_cmd"])
        return any(
            item["unit"] == row["id"] and item["tree_hash"] == digest
            and item.get("evidence_kind", "command") == "command"
            and item.get("cmd_hash") == command and item["verdict"] == "VERIFIED"
            and report_valid(run, item)
            for item in ledger_rows(run)
        )
    return any(item["unit"] == row["id"] and item.get("evidence_kind") == row["verify_kind"]
               and item["tree_hash"] == digest and item.get("verdict") == "VERIFIED"
               and item.get("final_hash") == (review_input_hash(repo, run) if row["verify_kind"] == "review" else digest)
               and item.get("cmd_hash") == command_hash(item.get("input_scope", ""))
               and item.get("input_hash") == tree_hash(repo, item.get("input_scope", row["scope"]))
               and report_valid(run, item)
               and (row.get("verify_kind") != "review" or independent_review_valid(run, item))
               for item in ledger_rows(run))


def independent_review_valid(run: Path, item: dict[str, str]) -> bool:
    try:
        path = (run / item["session_path"]).resolve()
        path.relative_to((run / "notes").resolve())
        first = json.loads(path.read_text(encoding="utf-8").splitlines()[0])
        return (item.get("evidence_kind") == "review" and item.get("observer")
                and first.get("type") == "session" and item["observer"] not in implementation_sessions(run)
                and first.get("id") == item["observer"]
                and file_digest(path) == item.get("session_hash"))
    except (OSError, ValueError, KeyError, IndexError, json.JSONDecodeError, TypeError):
        return False


def report_valid(run: Path, item: dict[str, str]) -> bool:
    try:
        report = (run / item["evidence_path"]).resolve()
        report.relative_to((run / "notes").resolve())
        return bool(item.get("report_hash")) and report.is_file() and hashlib.sha256(report.read_bytes()).hexdigest() == item["report_hash"]
    except (OSError, ValueError, KeyError):
        return False


def cmd_done(args: argparse.Namespace) -> None:
    repo = repo_of(args)
    run = run_dir(repo)
    with run_lock(run):
        rows = units(run)
        row = find_unit(rows, args.id)
        ensure_consistent(run)
        require_settled(run, args.id)
        if row["state"] not in {"doing", "verifying", "done", "abandoned"}:
            die(f"单元 {args.id} 当前是 {row['state']}，只能从 doing/verifying 完成")
        if row["state"] == "abandoned":
            die(f"单元 {args.id} 已终态 abandoned，先执行 xr reopen {args.id}")
        if not verified_now(repo, run, row):
            die(f"没有对应当前文件和当前验证命令的 VERIFIED ledger，不能 done。正确命令：xr verify {args.id}")
        row["state"] = "done"
        row["updated"] = stamp()
        text = (run / "RUN.md").read_text()
        text = with_epoch(text, epoch_of(text) + 1)
        commit_texts(run, {"units.tsv": tsv_text(HEADER, rows), "RUN.md": text})
        atomic_write_text(run / "pending-boundary.json", json.dumps({
            "nonce": f"{args.id}-{stamp()}",
            "dependsOnReasoning": False,
            "unrelated": False,
            "unattended": False,
        }))
        event(run, {"type": "done", "unit": args.id})
        refresh_status(run)
    say(f"ok done {args.id}")


def cmd_fail(args: argparse.Namespace) -> None:
    if args.kind not in FAIL_KINDS:
        die("kind 只能是 cap、net、tool、logic、verify、unknown。正确命令：xr fail <id> --kind net --record <引用>")
    if not args.record:
        die("故障/拆分记录需要 --record 引用错误、原运行和已有报告；正确命令：xr fail <id> --kind net --record <引用>")
    run = run_dir(repo_of(args))
    with run_lock(run):
        rows = units(run)
        row = find_unit(rows, args.id)
        if row["state"] in TERMINAL:
            die(f"单元 {args.id} 已终态 {row['state']}，不能 fail；需要重新处理时先 xr reopen {args.id}")
        if args.kind == "cap" and row["state"] == "blocked":
            die("blocked 单元不能按 cap 终止；先确认原运行已终止并执行 xr reopen")
        attempts = int(row["attempts"]) + 1
        row["attempts"] = str(attempts)
        row["updated"] = stamp()
        if args.kind == "cap":
            row["state"] = "abandoned"
            row["evidence"] = f"{row['evidence']};kind:cap;record:{cell(args.record)}"
            hint = f"xr plan add {args.id}b \"拆小后的标题\" --deps none --files {row['scope']} --verify \"{row['verify_cmd']}\""
        else:
            row["state"] = "blocked"
            row["evidence"] = f"{row['evidence']};kind:{args.kind};record:{cell(args.record)}"
            hint = f"核对原运行后执行 xr reopen {args.id} --resolution resumed|terminated --record <状态依据>"
        save_units(run, rows)
        event(run, {"type": "fail", "unit": args.id, "kind": args.kind, "state": row["state"], "record": args.record or "none"})
    say(f"ok fail {args.id} {row['state']} attempts={attempts}")
    say(f"正确命令：{hint}")


def unresolved_failure(run: Path, unit_id: str) -> bool:
    unresolved = False
    for line in (run / "events.jsonl").read_text().splitlines():
        try:
            item = json.loads(line)
        except json.JSONDecodeError:
            continue
        if item.get("unit") == unit_id and item.get("type") == "fail":
            unresolved = True
        elif item.get("unit") == unit_id and item.get("type") == "reopen" and item.get("resolution") == "terminated":
            unresolved = False
    return unresolved


def open_gates_for(run: Path, unit_id: str) -> list[str]:
    gates = (run / "gates.md").read_text()
    matches = re.finditer(r"^## (G\d+)\n(.*?)(?=^## |\Z)", gates, re.S | re.M)
    return [match.group(1) for match in matches
            if "- status: open" in match.group(2)
            and unit_id in next((line.split(": ", 1)[1].split(",") for line in match.group(2).splitlines() if line.startswith("- units: ")), [])]


def cmd_reopen(args: argparse.Namespace) -> None:
    if args.resolution not in {"resumed", "terminated"} or not args.record:
        die("恢复必须确认原运行仍可续接或已终止，并提供 --record；正确命令：xr reopen <id> --resolution resumed|terminated --record <状态依据>")
    run = run_dir(repo_of(args))
    with run_lock(run):
        rows = units(run)
        row = find_unit(rows, args.id)
        if row["state"] != "blocked" and row["state"] not in TERMINAL:
            die(f"单元 {args.id} 当前是 {row['state']}，只有 blocked 或终态才能 reopen")
        if row["state"] in TERMINAL and args.resolution != "terminated":
            die("终态单元只能在确认旧运行已终止后重新规划")
        unresolved = unresolved_failure(run, args.id)
        open_gates = open_gates_for(run, args.id)
        if open_gates:
            die(f"单元 {args.id} 仍被决策门阻塞：{','.join(open_gates)}")
        if unresolved and row["state"] != "blocked" and args.resolution != "terminated":
            die("仍有未解决故障；必须先处理阻塞单元或确认原运行已终止")
        if unresolved and args.resolution == "resumed" and row["state"] != "blocked":
            die("故障恢复只能从 blocked 继续原运行")
        if args.resolution == "resumed":
            readers, writers, total = limits()
            doing = [item for item in rows if item["state"] == "doing"]
            held = [item for item in rows if item["state"] == "blocked" and
                    (";kind:" in item["evidence"] or "blocked_from:doing" in item["evidence"])]
            occupied = doing + [item for item in held if item["id"] != row["id"]]
            if (len(occupied) >= total
                    or (is_writer(row["kind"]) and sum(is_writer(item["kind"]) for item in occupied) >= writers)
                    or (not is_writer(row["kind"]) and sum(not is_writer(item["kind"]) for item in occupied) >= readers)):
                die("并发额度已满；保留 blocked，待有额度后再恢复")
            if any(overlaps(row, item) for item in occupied):
                die("恢复范围与活跃单元冲突；保留 blocked，待范围释放后再恢复")
        prior = row["state"]
        if args.resolution == "resumed" and prior == "blocked" and ";kind:" not in row["evidence"] and "blocked_from:doing" not in row["evidence"]:
            die("该单元没有活跃原运行证据，不能按 resumed 恢复")
        row["state"] = "doing" if args.resolution == "resumed" else "todo"
        row["evidence"] = f"recovered:{args.resolution};record:{cell(args.record)}"
        row["updated"] = stamp()
        save_units(run, rows)
        event(run, {"type": "reopen", "unit": args.id, "from": prior, "resolution": args.resolution, "record": args.record})
    say(f"ok reopen {args.id} {row['state']}")


def record_decision(run: Path, unit: str, decision: str, reason: str, reversible: str) -> bool:
    rows = read_tsv(run / "decisions.tsv", DECISIONS)
    if rows and rows[-1]["decision"] == decision and rows[-1]["reason"] == reason and rows[-1]["unit"] == unit:
        return False
    rows.append({
        "ts": stamp(), "unit": unit, "decision": cell(decision), "reason": cell(reason),
        "alternatives": "none", "reversible": reversible, "by_model": model_of(run),
    })
    write_tsv(run / "decisions.tsv", DECISIONS, rows)
    return True


def cmd_decide(args: argparse.Namespace) -> None:
    if not args.text or not args.why:
        die("参数不够。正确命令：xr decide \"决定\" --why \"理由\"")
    run = run_dir(repo_of(args))
    with run_lock(run):
        wrote = record_decision(run, args.unit or "run", args.text, args.why, "Y" if args.reversible else "N")
    say(f"ok decide {'unchanged' if not wrote else 'recorded'}")


def cmd_gate(args: argparse.Namespace) -> None:
    if not args.text or not args.default:
        die("参数不够。正确命令：xr gate \"问题\" --default \"默认做法\"")
    run = run_dir(repo_of(args))
    with run_lock(run):
        text = (run / "gates.md").read_text()
        if f"- question: {args.text}" in text and "status: open" in text:
            say("ok gate unchanged")
            return
        number = text.count("\n## G") + 1
        block = (
            f"## G{number}\n"
            f"- question: {args.text}\n"
            f"- default: {args.default}\n"
            f"- deadline: Land 前无答复即按默认执行\n"
            f"- units: {args.unit or 'none'}\n"
            f"- status: open\n\n"
        )
        rows = units(run)
        if args.unit:
            row = find_unit(rows, args.unit)
            if row["state"] in TERMINAL:
                die(f"单元 {args.unit} 已终态 {row['state']}，不能设为 blocked")
        atomic_write_text(run / "gates.md", text + block)
        if args.unit:
            prior_state = row["state"]
            row["state"] = "blocked"
            if prior_state == "doing":
                row["evidence"] = f"{row['evidence']};blocked_from:doing;gate:G{number}"
            row["updated"] = stamp()
            save_units(run, rows)
        event(run, {"type": "gate", "unit": args.unit or "none"})
    say(f"ok gate G{number}")


def status_body(run: Path) -> str:
    rows = units(run)
    counts: dict[str, int] = {}
    for row in rows:
        counts[row["state"]] = counts.get(row["state"], 0) + 1
    lines = [f"run: {run.name}", f"mode: {mode_of(run, rows)}", f"units: {len(rows)}"]
    for state in ("todo", "doing", "verifying", "done", "failed", "blocked", "abandoned"):
        lines.append(f"{state}: {counts.get(state, 0)}")
    doing = [row["id"] for row in rows if row["state"] == "doing"]
    lines.append("doing_ids: " + (",".join(doing) if doing else "none"))
    return "\n".join(lines)


def refresh_status(run: Path) -> str:
    body = status_body(run)
    text = (run / "RUN.md").read_text()
    atomic_write_text(run / "RUN.md", replace_block(text, "<!-- xr:status:start -->", "<!-- xr:status:end -->", body))
    return body


def cmd_gate_resolve(args: argparse.Namespace) -> None:
    run = run_dir(repo_of(args))
    with run_lock(run):
        path = run / "gates.md"
        text = path.read_text()
        match = re.search(rf"^## {re.escape(args.gate)}\n.*?(?=^## |\Z)", text, re.S | re.M)
        if not match:
            die(f"没有决策门 {args.gate}")
        start, end = match.span()
        block = match.group(0)
        if "- status: open" not in block:
            die(f"决策门 {args.gate} 已不是 open")
        answer = args.answer if args.answer is not None else next((line.split(": ", 1)[1] for line in block.splitlines() if line.startswith("- default: ")), "")
        block = block.replace("- status: open", f"- status: resolved\n- answer: {cell(answer)}", 1)
        atomic_write_text(path, text[:start] + block + text[end:])
        event(run, {"type": "gate-resolve", "gate": args.gate, "unit": args.unit or "none", "answer": cell(answer)})
    say(f"ok gate {args.gate} resolved")


def cmd_status(args: argparse.Namespace) -> None:
    run = run_dir(repo_of(args))
    with run_lock(run):
        before = (run / "RUN.md").read_text()
        body = refresh_status(run)
    after = (run / "RUN.md").read_text()
    if before == after:
        say("ok status unchanged")
    else:
        say("ok status")
    say(body)


def section(text: str, title: str) -> str:
    match = re.search(rf"^## {re.escape(title)}\n(.*?)(?=^## |\Z)", text, re.S | re.M)
    return match.group(1).strip() if match else ""


def cmd_capsule(args: argparse.Namespace) -> None:
    run = run_dir(repo_of(args))
    with run_lock(run):
        write_capsule(run)


def write_capsule(run: Path) -> None:
    run_md = (run / "RUN.md").read_text()
    rows = units(run)
    current = next((row for row in rows if row["state"] == "doing"), None)
    if current is None:
        current = next((row for row in rows if row["state"] in {"todo", "failed", "verifying"}), None)
    decisions = read_tsv(run / "decisions.tsv", DECISIONS)[-3:]
    verified = [row["id"] for row in rows if row["state"] == "done"]
    if current and current["state"] == "doing":
        nxt = f"继续 {current['id']}，然后 xr verify {current['id']}"
    elif any(row["state"] == "todo" for row in rows):
        nxt = "xr next"
    else:
        nxt = "读 stages/review.md"
    lines = [
        f"# capsule {run.name}",
        "",
        "目标：" + one_line(section(run_md, "Intent"), 180),
        "Done：" + one_line(section(run_md, "Done"), 220),
        "当前：" + (f"{current['id']} {current['state']} {current['title']}" if current else "无"),
        "已完成：" + (",".join(verified[-12:]) if verified else "无"),
        "下一步：" + nxt,
        "文件：RUN.md units.tsv ledger.tsv",
        "模型：" + model_of(run),
        "决策：" + (" | ".join(item["decision"] for item in decisions) if decisions else "无"),
    ]
    text = "\n".join(lines) + "\n"
    encoded = text.encode()
    if len(encoded) > 2048:
        text = encoded[:2048].decode(errors="ignore").rstrip() + "\n"
    atomic_write_text(run / "capsule.md", text)
    say(f"ok capsule bytes={len(text.encode())}")


def one_line(text: str, limit: int) -> str:
    flat = " ".join(text.split())
    return flat[:limit] if flat else "未填"


def sha_file(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def cmd_close(args: argparse.Namespace) -> None:
    repo = repo_of(args)
    base = repo / ".work-docs" / "runs"
    run = run_dir(repo)
    active = base / "ACTIVE"
    with (base / ".init.lock").open("a+") as pointer_lock:
        fcntl.flock(pointer_lock.fileno(), fcntl.LOCK_EX)
        with run_lock(run):
            if not active.is_file() or active.read_text().strip() != run.name:
                die(f"ACTIVE 不是当前 run {run.name}")
            state = receipt_state(repo, run)
            atomic_write_text(run / "closed", f"closed: {stamp()}\nfinish: {state}\n")
            binding = read_binding(run)
            if binding and not binding.get("_invalid"):
                binding["lease"] = "released"
                write_binding(run, binding)
            active.unlink()
            event(run, {"type": "close", "finish": state})
    say(f"ok close {run.name} finish={state}")


def cmd_import(args: argparse.Namespace) -> None:
    repo = repo_of(args)
    if not re.fullmatch(r"[A-Za-z0-9_-]+", args.task_id):
        die("task-id 不合法。只能使用字母、数字、下划线和短横线")
    task = repo / ".work-docs" / "tasks" / args.task_id
    contract = task / "contract.md"
    state = task / "state.md"
    if not contract.is_file():
        die(f"找不到 {contract}。正确命令：xr import <task-id>")
    before = {str(path.relative_to(repo)): sha_file(path) for path in (contract, state) if path.is_file()}
    text = contract.read_text()
    objective = "imported"
    for line in text.splitlines():
        if line.startswith("objective:"):
            objective = line.split(":", 1)[1].strip() or objective
    # 复用一次 init 的目录规则，但不覆盖 ACTIVE 以外的旧任务文件。
    slug = re.sub(r"[^a-z0-9]+", "-", args.task_id.lower()).strip("-")[:40] or "import"
    ns = argparse.Namespace(slug=slug, repo=str(repo))
    cmd_init(ns)
    run = run_dir(repo)
    rows = units(run)
    imported = 0
    for line in text.splitlines():
        if not line.startswith("work_item:"):
            continue
        name, *segments = line[len("work_item:"):].split("|")
        fields = {}
        for segment in segments:
            if "=" in segment:
                key, value = segment.split("=", 1)
                fields[key] = value
        if not ID_RE.fullmatch(name):
            continue
        scope = fields.get("scope") or "README.md"
        try:
            check_scope(scope)
        except SystemExit:
            scope = "README.md"
        rows.append({
            "id": name, "title": fields.get("title", name), "state": "todo", "deps": fields.get("depends") or "none",
            "scope": scope, "output_scope": scope, "timebox_min": "45", "attempts": "0", "owner": "import", "model": "unknown",
            "verify_cmd": "false", "verify_kind": "command", "evidence": f"imported:{args.task_id};rewrite verify_cmd before xr verify", "updated": stamp(), "kind": "impl",
        })
        imported += 1
    if imported == 0:
        rows.append({
            "id": "imported", "title": objective[:80], "state": "todo", "deps": "none", "scope": "README.md", "output_scope": "README.md",
            "timebox_min": "45", "attempts": "0", "owner": "import", "model": "unknown", "verify_cmd": "false", "verify_kind": "command",
            "evidence": f"imported:{args.task_id};rewrite verify_cmd before xr verify", "updated": stamp(), "kind": "impl",
        })
    if cycles(rows):
        die("导入任务依赖有环，已拒绝")
    with run_lock(run):
        after = {str(path.relative_to(repo)): sha_file(path) for path in (contract, state) if path.is_file()}
        if before != after:
            die("导入期间旧任务文件改变，已停止")
        save_units(run, rows)
        event(run, {"type": "import", "task": args.task_id, "units": len(rows)})
    say(f"ok import {args.task_id} units={len(rows)}")


def epoch_of(text: str) -> int:
    match = re.search(r"^dispatch_epoch:\s*(\d+)\s*$", text, re.M)
    return int(match.group(1)) if match else 0


def with_epoch(text: str, epoch: int) -> str:
    line = f"dispatch_epoch: {epoch}"
    if re.search(r"^dispatch_epoch:\s*\d+\s*$", text, re.M):
        return re.sub(r"^dispatch_epoch:\s*\d+\s*$", line, text, count=1, flags=re.M)
    if "format_version: 2\n" in text:
        return text.replace("format_version: 2\n", f"format_version: 2\n{line}\n", 1)
    return line + "\n" + text


def phase_of(text: str) -> str:
    match = re.search(r"^phase:\s*(\S+)", text, re.M)
    return match.group(1) if match else ""


def set_phase(text: str, phase: str) -> str:
    if re.search(r"^phase:\s*\S+", text, re.M):
        return re.sub(r"^phase:\s*\S+", f"phase: {phase}", text, count=1, flags=re.M)
    return text.rstrip() + f"\nphase: {phase}\n"


def tsv_text(header: list[str], rows: list[dict[str, str]]) -> str:
    body = ["\t".join(header)]
    for row in rows:
        body.append("\t".join(cell(row[key]) for key in header))
    return "\n".join(body) + "\n"


def commit_texts(run: Path, files: dict[str, str]) -> None:
    for name, text in files.items():
        atomic_write_text(run / name, text)


def bump_epoch(run: Path) -> int:
    text = (run / "RUN.md").read_text()
    updated = with_epoch(text, epoch_of(text) + 1)
    atomic_write_text(run / "RUN.md", updated)
    return epoch_of(updated)


def file_digest(path: Path) -> str:
    if not path.is_file():
        return "sha256:missing"
    return "sha256:" + hashlib.sha256(path.read_bytes()).hexdigest()


def read_binding(run: Path) -> dict | None:
    path = run / "binding.json"
    if not path.is_file():
        return None
    try:
        data = json.loads(path.read_text())
    except json.JSONDecodeError:
        return {"_invalid": True}
    if not isinstance(data, dict) or data.get("schema") != 1 or not data.get("session_id") or not data.get("run_id"):
        return {"_invalid": True}
    return data


def write_binding(run: Path, data: dict) -> None:
    payload = {key: value for key, value in data.items() if key != "_invalid"}
    atomic_write_text(run / "binding.json", json.dumps(payload, ensure_ascii=False, indent=2) + "\n")


def soft_tsv(path: Path, header: list[str]) -> str | None:
    if not path.is_file():
        return "missing"
    lines = path.read_text().splitlines()
    if not lines or lines[0].split("\t") != header:
        return "header"
    for line in lines[1:]:
        if line.strip() and len(line.split("\t")) != len(header):
            return "columns"
    return None


def classify_run(repo: Path, run: Path) -> tuple[str, list[str]]:
    text = (run / "RUN.md").read_text()
    has_phase = bool(re.search(r"^phase:\s*\S+", text, re.M))
    has_binding = (run / "binding.json").is_file()
    has_acceptance = (run / "acceptance.tsv").is_file()
    if not has_phase and not has_binding and not has_acceptance:
        return "legacy", ["legacy"]
    reasons: list[str] = []
    if not has_phase:
        reasons.append("缺少 phase")
    binding = read_binding(run) if has_binding else None
    if binding is None:
        reasons.append("缺少 binding.json")
    elif binding.get("_invalid"):
        reasons.append("binding.json 损坏")
    else:
        if binding.get("run_id") != run.name:
            reasons.append("binding run_id 不一致")
        workspace = binding.get("workspace")
        if not isinstance(workspace, str) or Path(workspace).resolve() != repo.resolve():
            reasons.append("binding workspace 不一致")
    acceptance_error = soft_tsv(run / "acceptance.tsv", ACCEPTANCE)
    if acceptance_error == "missing":
        reasons.append("缺少 acceptance.tsv")
    elif acceptance_error:
        reasons.append(f"acceptance.tsv {acceptance_error}")
    if reasons:
        return "invalid", reasons
    return "managed", []


def ensure_consistent(run: Path) -> None:
    mode, reasons = classify_run(run.parent.parent.parent, run)
    if mode == "invalid":
        die("运行结构无效：" + ",".join(reasons) + "。正确命令：不要手改运行目录，用 xr init 或 xr bind")


def automation_blocked(run: Path) -> str:
    text = (run / "RUN.md").read_text()
    phase = phase_of(text)
    if phase and phase != "executing":
        return phase
    binding = read_binding(run)
    if binding and not binding.get("_invalid") and binding.get("lease") not in {None, "active"}:
        return f"lease:{binding.get('lease')}"
    pending, corrupt = unresolved_ops(run)
    if corrupt:
        return "事件日志损坏"
    if pending:
        return "unresolved:" + ",".join(pending)
    if pending_workers(run):
        return "pending-workers"
    return ""


def current_session(args: argparse.Namespace) -> str | None:
    return getattr(args, "session", None) or CALLER_SESSION


def source_ref(repo: Path, raw: str) -> str:
    if raw.startswith("session:"):
        if not re.fullmatch(r"session:[A-Za-z0-9_-]+#entry:[A-Za-z0-9_-]+", raw):
            die("source 不合法。正确命令：xr acceptance set <id> \"语句\" --source <相对路径> --units a,b")
        return raw
    path = (repo / raw).resolve()
    try:
        path.relative_to(repo.resolve())
    except ValueError:
        die(f"source 越出仓库：{raw}")
    if not path.is_file():
        die(f"找不到来源 {raw}。正确命令：--source 使用仓库内已有文件")
    digest = hashlib.sha256(path.read_bytes()).hexdigest()
    return f"{raw}#sha256:{digest}"


def entry_exists(transcript: Path, entry_id: str) -> bool:
    """#entry: 指向的记录必须真实存在；只校验格式会让任意编号都能当证据。"""
    try:
        for line in transcript.read_text(encoding="utf-8").splitlines():
            if not line.strip():
                continue
            try:
                item = json.loads(line)
            except json.JSONDecodeError:
                return False
            if isinstance(item, dict) and item.get("id") == entry_id:
                return True
    except OSError:
        return False
    return False


def source_ok(repo: Path, stored: str, run: Path | None = None, units: set[str] | None = None) -> tuple[bool, str]:
    if stored.startswith("session:"):
        # 会话来源不能只看格式：必须是覆盖该验收单元的审查证据，且副本在 notes/ 里。
        match = re.fullmatch(r"session:([A-Za-z0-9_-]+)#entry:([A-Za-z0-9_-]+)", stored)
        if not match:
            return False, "source 不合法"
        if run is None:
            return False, "session 来源需要运行目录"
        session_id, entry_id = match.group(1), match.group(2)
        for item in ledger_rows(run):
            if item.get("observer") != session_id or not item.get("session_path"):
                continue
            if units is not None and item.get("unit") not in units:
                continue
            try:
                saved = (run / item["session_path"]).resolve()
                saved.relative_to((run / "notes").resolve())
            except (OSError, ValueError):
                continue
            if not saved.is_file() or not item.get("session_hash"):
                continue
            if file_digest(saved) != item["session_hash"]:
                continue
            if not entry_exists(saved, entry_id):
                continue
            return True, ""
        return False, "session 来源没有对应审查会话证据"
    if "#sha256:" not in stored:
        return False, "source 缺摘要"
    rel, digest = stored.rsplit("#sha256:", 1)
    path = (repo / rel).resolve()
    try:
        path.relative_to(repo.resolve())
    except ValueError:
        return False, f"{rel} 越界"
    if not path.is_file():
        return False, f"{rel} 不可读"
    if hashlib.sha256(path.read_bytes()).hexdigest() != digest:
        return False, f"{rel} 摘要不匹配"
    return True, ""


def acceptance_rows(run: Path) -> list[dict[str, str]]:
    path = run / "acceptance.tsv"
    if not path.is_file() or not path.read_text().strip():
        return []
    return read_tsv(path, ACCEPTANCE)


def unit_ids_of(raw: str) -> list[str]:
    parts = [part.strip() for part in raw.split(",") if part.strip()]
    if not parts:
        die("验收单元为空。正确命令：--units a,b")
    for part in parts:
        if not ID_RE.fullmatch(part):
            die(f"验收单元不合法：{part}")
    return parts


def try_verified(repo: Path, run: Path, row: dict[str, str]) -> bool:
    try:
        return verified_now(repo, run, row)
    except (SystemExit, OSError, ValueError):
        return False


def read_events(run: Path) -> tuple[list[dict], bool]:
    path = run / "events.jsonl"
    if not path.is_file():
        return [], True
    records = []
    corrupt = False
    for line in path.read_text().splitlines():
        if not line.strip():
            continue
        try:
            item = json.loads(line)
            if not isinstance(item, dict) or not isinstance(item.get("type"), str):
                corrupt = True
            else:
                records.append(item)
        except json.JSONDecodeError:
            corrupt = True
    return records, corrupt


def prepare_worker(repo: Path, run: Path, detail: dict) -> dict:
    for key in ("op_id", "unit", "child_run_id", "status_path", "launch_digest"):
        if not isinstance(detail.get(key), str) or not detail[key]:
            die(f"启动回执缺少 {key}")
    row = find_unit(units(run), detail["unit"])
    if row["state"] != "doing":
        die("子任务只能绑定已认领的 doing 单元")
    events, corrupt = read_events(run)
    if corrupt:
        die("事件日志损坏，拒绝登记启动")
    if any(item["type"] == "worker_started" and item.get("detail", {}).get("child_run_id") == detail["child_run_id"] for item in events):
        die("子运行已登记，不能重新绑定")
    return {**detail, "input_hash": tree_hash(repo, row["scope"]), "status_path": str(Path(detail["status_path"]).resolve())}


def worker_records(run: Path) -> tuple[dict[str, dict], dict[str, dict]]:
    events, _ = read_events(run)
    started: dict[str, dict] = {}
    received: dict[str, dict] = {}
    for item in events:
        detail = item.get("detail", {})
        if not isinstance(detail, dict):
            continue
        child = detail.get("child_run_id")
        if not isinstance(child, str):
            continue
        if item["type"] == "worker_started":
            started[child] = detail
        elif item["type"] == "worker_received":
            received[child] = detail
    return started, received


def received_valid(run: Path, start: dict, receipt: dict) -> bool:
    try:
        path = (run / receipt["path"]).resolve()
        path.relative_to((run / "notes").resolve())
        if file_digest(path) != receipt["digest"] or file_digest(Path(start["status_path"])) != receipt["status_digest"]:
            return False
        saved = json.loads(path.read_text())
        return all(file_digest(Path(item["path"])) == item["digest"] for item in saved["artifacts"])
    except (OSError, ValueError, KeyError, TypeError):
        return False


def pending_workers(run: Path, unit: str | None = None) -> list[str]:
    started, received = worker_records(run)
    return [child for child, start in started.items() if (unit is None or start.get("unit") == unit)
            and (child not in received or not received_valid(run, start, received[child]))]


def require_settled(run: Path, unit: str) -> None:
    pending, corrupt = unresolved_ops(run)
    if corrupt or pending or pending_workers(run, unit):
        die("有未核实工具或未接收子任务，不能验收：" + ",".join(pending + pending_workers(run, unit)))


def cmd_receive(args: argparse.Namespace) -> None:
    repo = repo_of(args)
    run = run_dir(repo)
    with run_lock(run):
        row = find_unit(units(run), args.id)
        try:
            path = Path(args.receipt).resolve()
            raw = path.read_bytes()
            status = json.loads(raw)
        except (OSError, ValueError):
            die("无法读取宿主状态回执")
        if not isinstance(status, dict):
            die("回执必须是对象")
        child = status.get("runId")
        started, received = worker_records(run)
        if not isinstance(child, str) or child not in started:
            die("回执的子 run 未登记启动")
        start = started[child]
        if start["unit"] != args.id or Path(start["status_path"]).resolve() != path:
            die("回执单元或状态路径与启动记录不一致")
        if status.get("toolCallId") != start["op_id"] or status.get("launchContractDigest") != start["launch_digest"]:
            die("回执的启动调用或合同摘要不一致")
        if tree_hash(repo, row["scope"]) != start["input_hash"]:
            die("子任务读入文件已改变，不能接收旧结果")
        terminal = status.get("processTerminal")
        steps = status.get("steps")
        if status.get("state") != "complete" or not isinstance(terminal, dict) or terminal.get("state") != "observed" or terminal.get("runId") != child:
            die("子任务终态或进程退出尚未确认成功")
        instances = terminal.get("instances")
        if not isinstance(instances, list) or not instances or any(not isinstance(item, dict) or item.get("exitCode") != 0 or item.get("signal") for item in instances):
            die("进程退出失败或未知")
        if not isinstance(steps, list) or not steps:
            die("子任务步骤为空")
        sessions = []
        artifacts = []
        try:
            for step in steps:
                if not isinstance(step, dict) or step.get("status") != "complete" or step.get("exitCode") != 0:
                    die("子任务包含失败或未完成步骤")
                session_path = Path(step["sessionFile"]).resolve()
                first = json.loads(session_path.read_text().splitlines()[0])
                if first.get("type") != "session" or not isinstance(first.get("id"), str):
                    die("子会话标识无效")
                sessions.append(first["id"])
                artifacts.append({"path": str(session_path), "digest": file_digest(session_path)})
            if status.get("outputFile"):
                output = Path(status["outputFile"]).resolve()
                if not output.is_file():
                    die("子任务输出文件不可读")
                artifacts.append({"path": str(output), "digest": file_digest(output)})
        except (OSError, ValueError, KeyError, IndexError, TypeError):
            die("子任务会话文件或输出证据无效")
        if child in received:
            if received_valid(run, start, received[child]):
                say(f"ok receive {args.id} duplicate")
                return
            die("已接收回执的证据改变，保持阻塞；需核实后重新规划")
        token = hashlib.sha256((child + start["op_id"]).encode()).hexdigest()
        saved_path = run / "notes" / f"received-{token}.json"
        saved = {"schema": 1, "child_run_id": child, "child_sessions": sessions, "unit": args.id,
                 "input_hash": start["input_hash"], "output_hash": verification_hash(repo, row), "artifacts": artifacts,
                 "status": status, "record": args.record}
        with saved_path.open("x", encoding="utf-8") as output:
            json.dump(saved, output, ensure_ascii=False, indent=2)
            output.flush()
            os.fsync(output.fileno())
        event(run, {"type": "worker_received", "child_run_id": child, "unit": args.id,
                    "path": saved_path.relative_to(run).as_posix(), "digest": file_digest(saved_path),
                    "status_digest": "sha256:" + hashlib.sha256(raw).hexdigest()})
    say(f"ok receive {args.id} {child}")


def unresolved_ops(run: Path) -> tuple[list[str], bool]:
    events, truncated = read_events(run)
    results: set[str] = set()
    intents: list[str] = []
    for item in events:
        detail = item.get("detail") if isinstance(item.get("detail"), dict) else {}
        op_id = item.get("op_id") or detail.get("op_id")
        if not op_id:
            continue
        kind = item.get("type")
        if kind == "op_result" and (item.get("outcome") or detail.get("outcome")) == "success":
            results.add(str(op_id))
        elif kind == "op_reconcile" and (item.get("resolution") or detail.get("resolution")) in {"completed", "not-started"}:
            results.add(str(op_id))
        elif kind == "op_intent":
            intents.append(str(op_id))
    return [op_id for op_id in intents if op_id not in results], truncated


def open_gate_ids(run: Path) -> list[str]:
    path = run / "gates.md"
    if not path.is_file():
        return []
    text = path.read_text()
    return [match.group(1) for match in re.finditer(r"^## (G\d+)\n(.*?)(?=^## |\Z)", text, re.S | re.M)
            if "- status: open" in match.group(2)]


def blank_inspect(run: Path, mode: str, reasons: list[str]) -> dict:
    return {
        "schema_version": 1,
        "mode": mode,
        "run_id": run.name,
        "phase": phase_of((run / "RUN.md").read_text()),
        "automation_allowed": False,
        "done_met": False,
        "ready": [],
        "doing": [],
        "blocked": [],
        "stale_units": [],
        "unresolved_ops": [],
        "pending_workers": [],
        "receipt_status": "missing",
        "acceptance_status": {"total": 0, "covered": 0},
        "reasons": reasons,
        "truncated_tail": False,
    }


def inspect_data(repo: Path, run: Path, include_receipt: bool = True) -> dict:
    mode, reasons = classify_run(repo, run)
    if mode != "managed":
        return blank_inspect(run, mode, reasons)
    rows = units(run)
    text = (run / "RUN.md").read_text()
    binding = read_binding(run) or {}
    acc = acceptance_rows(run)
    pending, truncated = unresolved_ops(run)
    workers = pending_workers(run)
    stale = [row["id"] for row in rows if row["state"] == "done" and not try_verified(repo, run, row)]
    abandoned = [row["id"] for row in rows if row["state"] == "abandoned"]
    referenced = {part.strip() for item in acc for part in item["units"].split(",") if part.strip()}
    problems: list[str] = []
    if not rows:
        problems.append("没有单元")
    for row in rows:
        if row["state"] in {"todo", "doing", "verifying", "failed", "blocked"}:
            problems.append(f"{row['id']} {row['state']}")
    if not acc:
        for unit_id in abandoned:
            problems.append(f"abandoned:{unit_id}")
        problems.append("验收表为空")
    else:
        for unit_id in abandoned:
            if unit_id in referenced:
                problems.append(f"abandoned:{unit_id}")
    covered = 0
    by_id = {row["id"]: row for row in rows}
    for item in acc:
        ids = [part.strip() for part in item["units"].split(",") if part.strip()]
        ok, why = source_ok(repo, item["source"], run, set(ids))
        matched = []
        for unit_id in ids:
            row = by_id.get(unit_id)
            matched.append(bool(row) and row["state"] == "done" and unit_id not in abandoned and try_verified(repo, run, row))
        if ok and ids and all(matched):
            covered += 1
        elif not ok:
            problems.append(f"{item['id']} {why}")
        else:
            problems.append(f"{item['id']} 未覆盖")
    if not any(row["kind"] == "integration" and row["state"] == "done" and try_verified(repo, run, row) for row in rows):
        problems.append("缺少最终集成单元")
    for unit_id in stale:
        problems.append(f"stale:{unit_id}")
    review_rows = [item for item in ledger_rows(run) if item.get("evidence_kind") == "review"]
    valid_reviews = [item for item in review_rows if item["unit"] in by_id
                     and by_id[item["unit"]]["state"] == "done" and try_verified(repo, run, by_id[item["unit"]])
                     and report_valid(run, item) and independent_review_valid(run, item)
                     and item.get("final_hash") == review_input_hash(repo, run)]
    if review_rows and not valid_reviews:
        problems.append("独立审查证据过期或无效")
    receipt = receipt_state(repo, run, inspect_current=False) if include_receipt else "missing"
    if include_receipt and receipt == "valid" and problems:
        receipt = "stale"
    if include_receipt and receipt in {"stale", "invalid"}:
        problems.append(f"receipt:{receipt}")
    if truncated:
        problems.append("事件日志损坏")
    for op_id in pending:
        problems.append(f"unresolved:{op_id}")
    for worker in workers:
        problems.append(f"pending-worker:{worker}")
    for gate_id in open_gate_ids(run):
        problems.append(f"gate:{gate_id}")
    if re.search(r"^review_required:\s*true\s*$", text, re.M) and not valid_reviews:
        problems.append("缺少独立审查")
    phase = phase_of(text)
    return {
        "schema_version": 1,
        "mode": "managed",
        "run_id": run.name,
        "phase": phase,
        "automation_allowed": phase == "executing" and not pending and not truncated and not workers and binding.get("lease") == "active" and binding.get("session_id") != "local" and isinstance(binding.get("generation"), int),
        "binding": {key: binding.get(key) for key in ("session_id", "generation", "lease")},
        "done_met": not problems,
        "ready": [row["id"] for row in rows if ready(repo, run, row, rows)],
        "doing": [row["id"] for row in rows if row["state"] == "doing"],
        "blocked": [row["id"] for row in rows if row["state"] == "blocked"],
        "stale_units": stale,
        "unresolved_ops": pending,
        "pending_workers": workers,
        "receipt_status": receipt,
        "acceptance_status": {"total": len(acc), "covered": covered},
        "reasons": problems,
        "truncated_tail": truncated,
    }


def review_digest_of(run: Path) -> str:
    valid = [item for item in ledger_rows(run) if item.get("evidence_kind") == "review"
             and report_valid(run, item) and independent_review_valid(run, item)]
    return hashlib.sha256("\n".join(item.get("session_hash", "") + item.get("report_hash", "") + item.get("final_hash", "")
                                        for item in valid).encode()).hexdigest()


def receipt_state(repo: Path, run: Path, inspect_current: bool = True) -> str:
    path = run / "finish.json"
    if not path.is_file():
        return "missing"
    try:
        data = json.loads(path.read_text())
        if not isinstance(data, dict) or data.get("schema") != 1:
            return "invalid"
    except (OSError, json.JSONDecodeError):
        return "invalid"
    snap = inspect_data(repo, run, include_receipt=False) if inspect_current else None
    text = (run / "RUN.md").read_text()
    try:
        parts = [row["id"] + "=" + verification_hash(repo, row) for row in units(run) if row["state"] == "done"]
        tree = "sha256:" + hashlib.sha256("\n".join(parts).encode()).hexdigest()
    except (OSError, ValueError, SystemExit):
        return "stale"
    same = (
        data.get("run_id") == run.name
        and data.get("tree_digest") == tree
        and data.get("dispatch_epoch") == epoch_of(text)
        and data.get("acceptance_digest") == file_digest(run / "acceptance.tsv")
        and data.get("units_digest") == file_digest(run / "units.tsv")
        and data.get("ledger_digest") == file_digest(run / "ledger.tsv")
        and data.get("review_digest") == review_digest_of(run)
        and (snap is None or snap.get("done_met") is True)
        and (snap is None or not snap.get("stale_units"))
    )
    return "valid" if same else "stale"


def cmd_inspect(args: argparse.Namespace) -> None:
    repo = repo_of(args)
    run = run_dir(repo)
    snap = inspect_data(repo, run)
    say(json.dumps(snap, ensure_ascii=False))
    if snap["mode"] == "invalid":
        raise SystemExit(2)


def cmd_handoff(args: argparse.Namespace) -> None:
    """暂停记录只由 xr 写：扩展不得直接改运行目录。"""
    repo = repo_of(args)
    run = run_dir(repo)
    reason = cell(args.reason)
    if not reason:
        die("handoff 需要非空 --reason")
    with run_lock(run):
        body = (
            f"# handoff {run.name}\n\n"
            f"阻塞：{reason}\n\n"
            "已完成和未完成以 units.tsv 和 ledger.tsv 为准，这里不抄表。\n\n"
            "下一条命令：\n\n```\nxr status\n```\n\n"
            "恢复：读 capsule.md，再执行 xr status；不要重做已有 VERIFIED 单元。\n"
        )
        atomic_write_text(run / "handoff.md", body)
        event(run, {"type": "handoff", "reason": reason})
    say(f"ok handoff {run.name}")


def cmd_guard(args: argparse.Namespace) -> None:
    """守卫的续跑计数与阻塞指纹：必须在运行锁内写，扩展不得直接改运行目录。"""
    if args.guard_verb != "set":
        die("用法：xr guard set --continues N --stalled N --fingerprint F [--boundary-nonce N]")
    repo = repo_of(args)
    run = run_dir(repo)
    with run_lock(run):
        path = run / "guard.json"
        data: dict[str, object] = {}
        if path.is_file():
            try:
                loaded = json.loads(path.read_text())
                if isinstance(loaded, dict):
                    data = loaded
            except json.JSONDecodeError:
                data = {}
        data.update({"schema": 1, "continues": args.continues, "stalled": args.stalled, "fingerprint": args.fingerprint})
        if args.boundary_nonce:
            data["boundaryNonce"] = args.boundary_nonce
        atomic_write_text(path, json.dumps(data, ensure_ascii=False) + "\n")
        event(run, {"type": "guard", "continues": args.continues, "stalled": args.stalled})
    say(f"ok guard {args.continues} {args.stalled}")


def cmd_acceptance_set(args: argparse.Namespace) -> None:
    if not args.statement or not args.source or not args.units:
        die("参数不够。正确命令：xr acceptance set <id> \"语句\" --source <相对路径> --units a,b")
    if not ID_RE.fullmatch(args.id):
        die(f"验收 id 不合法：{args.id}")
    repo = repo_of(args)
    run = run_dir(repo)
    ref = source_ref(repo, args.source)
    ids = unit_ids_of(args.units)
    with run_lock(run):
        ensure_consistent(run)
        known = {row["id"] for row in units(run)}
        missing = [unit_id for unit_id in ids if unit_id not in known]
        if missing:
            die("验收单元不存在：" + ",".join(missing))
        rows = acceptance_rows(run)
        fresh = {"id": args.id, "statement": cell(args.statement), "source": ref, "units": ",".join(ids), "status": "pending"}
        replaced = False
        for index, row in enumerate(rows):
            if row["id"] == args.id:
                rows[index] = fresh
                replaced = True
        if not replaced:
            rows.append(fresh)
        write_tsv(run / "acceptance.tsv", ACCEPTANCE, rows)
        bump_epoch(run)
        event(run, {"type": "acceptance", "id": args.id, "units": fresh["units"], "replaced": replaced})
    say(f"ok acceptance {args.id} {'updated' if replaced else 'set'}")


def cmd_acceptance_list(args: argparse.Namespace) -> None:
    run = run_dir(repo_of(args))
    say(json.dumps({"rows": acceptance_rows(run)}, ensure_ascii=False))


def cmd_acceptance_rebind(args: argparse.Namespace) -> None:
    ids = unit_ids_of(args.units)
    repo = repo_of(args)
    run = run_dir(repo)
    with run_lock(run):
        ensure_consistent(run)
        known = {row["id"] for row in units(run)}
        missing = [unit_id for unit_id in ids if unit_id not in known]
        if missing:
            die("验收单元不存在：" + ",".join(missing))
        rows = acceptance_rows(run)
        found = False
        for row in rows:
            if row["id"] == args.id:
                row["units"] = ",".join(ids)
                row["status"] = "pending"
                found = True
        if not found:
            die(f"没有验收 {args.id}。正确命令：xr acceptance set {args.id} \"语句\" --source <路径> --units {args.units}")
        write_tsv(run / "acceptance.tsv", ACCEPTANCE, rows)
        bump_epoch(run)
        event(run, {"type": "acceptance-rebind", "id": args.id, "units": ",".join(ids)})
    say(f"ok acceptance rebind {args.id}")


def cmd_finish(args: argparse.Namespace) -> None:
    repo = repo_of(args)
    run = run_dir(repo)
    with run_lock(run):
        snap = inspect_data(repo, run)
        # 收据过期/损坏只能由 finish 自己刷新；除此之外的问题一律拒绝。
        blocking = [reason for reason in snap["reasons"] if not reason.startswith("receipt:")]
        if snap["mode"] != "managed" or blocking:
            why = ",".join(blocking) or snap["mode"]
            die(f"不能 finish：{why}。正确命令：补齐验收和集成验证后重试")
        text = (run / "RUN.md").read_text()
        epoch = epoch_of(text) + 1
        text = set_phase(with_epoch(text, epoch), "finished")
        parts = []
        for row in units(run):
            if row["state"] == "done":
                parts.append(row["id"] + "=" + verification_hash(repo, row))
        receipt = {
            "schema": 1,
            "run_id": run.name,
            "finished_at": stamp(),
            "acceptance_digest": file_digest(run / "acceptance.tsv"),
            "units_digest": file_digest(run / "units.tsv"),
            "ledger_digest": file_digest(run / "ledger.tsv"),
            "review_digest": review_digest_of(run),
            "tree_digest": "sha256:" + hashlib.sha256("\n".join(parts).encode()).hexdigest(),
            "dispatch_epoch": epoch,
            "unresolved_ops": 0,
        }
        atomic_write_text(run / "finish.json", json.dumps(receipt, ensure_ascii=False, indent=2) + "\n")
        atomic_write_text(run / "RUN.md", text)
        event(run, {"type": "finish", "acceptance_digest": receipt["acceptance_digest"], "tree_digest": receipt["tree_digest"]})
    say(f"ok finish {run.name}")


def cmd_pause(args: argparse.Namespace) -> None:
    if not args.reason or not args.record:
        die("参数不够。正确命令：xr pause --reason \"原因\" --record <引用>")
    run = run_dir(repo_of(args))
    with run_lock(run):
        ensure_consistent(run)
        atomic_write_text(run / "RUN.md", set_phase((run / "RUN.md").read_text(), "paused"))
        binding = read_binding(run)
        if binding and not binding.get("_invalid"):
            binding["lease"] = "paused"
            write_binding(run, binding)
        event(run, {"type": "pause", "reason": args.reason, "record": args.record})
    say("ok pause")


def cmd_resume(args: argparse.Namespace) -> None:
    if not args.confirm or not args.record:
        die("恢复需要确认。正确命令：xr resume --confirm --record <依据>")
    repo = repo_of(args)
    run = run_dir(repo)
    session = current_session(args)
    if not session:
        die("恢复需要真实 session，人工离线操作请显式 --offline")
    with run_lock(run, validate=False):
        binding = read_binding(run)
        if not binding or binding.get("_invalid"):
            die("没有有效绑定。正确命令：xr bind --session <id>")
        if binding.get("run_id") != run.name or Path(str(binding.get("workspace"))).resolve() != repo.resolve():
            die("绑定与当前仓库或运行不一致")
        previous = str(binding.get("session_id"))
        took_over = None
        if previous != session:
            if not args.take_ownership:
                die(f"运行被会话 {previous} 占用。正确命令：xr resume --confirm --take-ownership --record <依据>")
            took_over = previous
            binding["session_id"] = session
        binding["generation"] = int(binding.get("generation", 0)) + 1
        binding["lease"] = "active"
        write_binding(run, binding)
        text = set_phase((run / "RUN.md").read_text(), "executing")
        atomic_write_text(run / "RUN.md", with_epoch(text, epoch_of(text) + 1))
        stale = run / "finish.json"
        if stale.is_file():
            os.replace(stale, run / "finish.invalid.json")
        payload = {"type": "resume", "record": args.record, "session_id": session}
        if took_over:
            payload["took_over_from"] = took_over
        event(run, payload)
    say(f"ok resume {session}")


def cmd_bind(args: argparse.Namespace) -> None:
    if not args.session:
        die("需要 --session。正确命令：xr bind --session <id>")
    repo = repo_of(args)
    run = run_dir(repo)
    with run_lock(run, validate=False):
        binding = read_binding(run)
        if binding and not binding.get("_invalid") and binding.get("session_id") != args.session:
            die(f"该运行被另一会话占用：{binding.get('session_id')}。正确命令：xr resume --confirm --take-ownership --record <依据>")
        created = binding.get("created_at") if binding and not binding.get("_invalid") else stamp()
        write_binding(run, {
            "schema": 1,
            "workspace": str(repo.resolve()),
            "run_id": run.name,
            "session_id": args.session,
            "generation": int((binding or {}).get("generation", 0)) + 1,
            "owner": "host",
            "created_at": created,
            "lease": "active",
        })
        event(run, {"type": "bind", "session_id": args.session})
    say(f"ok bind {args.session}")


def build() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="xr", add_help=True)
    parser.add_argument("--repo", default=None)
    sub = parser.add_subparsers(dest="verb")
    init = sub.add_parser("init")
    init.add_argument("slug")
    init.add_argument("--offline", action="store_true")
    init.set_defaults(func=cmd_init)
    plan = sub.add_parser("plan")
    plan_sub = plan.add_subparsers(dest="plan_verb")
    add = plan_sub.add_parser("add")
    add.add_argument("id")
    add.add_argument("title")
    add.add_argument("--deps", default=None)
    add.add_argument("--files", default=None, help="readable inputs or legacy combined scope")
    add.add_argument("--output", dest="output_scope", help="exclusive outputs; defaults to --files for writer kinds")
    add.add_argument("--verify", default=None)
    add.add_argument("--verify-kind", choices=["command", "observation", "review"], default="command")
    add.add_argument("--kind", default="impl")
    add.add_argument("--timebox", type=int)
    add.set_defaults(func=cmd_plan_add)
    nxt = sub.add_parser("next")
    nxt.set_defaults(func=cmd_next)
    verify = sub.add_parser("verify")
    verify.add_argument("id")
    verify.add_argument("--timeout", type=int)
    verify.set_defaults(func=cmd_verify)
    handoff = sub.add_parser("handoff")
    handoff.add_argument("--reason", required=True)
    handoff.set_defaults(func=cmd_handoff)
    guard = sub.add_parser("guard")
    guard_sub = guard.add_subparsers(dest="guard_verb")
    guard_set = guard_sub.add_parser("set")
    guard_set.add_argument("--continues", type=int, required=True)
    guard_set.add_argument("--stalled", type=int, required=True)
    guard_set.add_argument("--fingerprint", required=True)
    guard_set.add_argument("--boundary-nonce", default=None)
    guard_set.set_defaults(func=cmd_guard)
    evidence = sub.add_parser("evidence")
    evidence_sub = evidence.add_subparsers(dest="evidence_verb")
    record = evidence_sub.add_parser("record")
    record.add_argument("id")
    record.add_argument("--kind", choices=["observation", "review"], required=True)
    record.add_argument("--report", required=True)
    record.add_argument("--inputs", default=None, help="审查覆盖的仓库内输入路径，逗号分隔")
    record.add_argument("--observer", default=None, help="独立审查会话 transcript 文件")
    record.add_argument("--record", required=True)
    record.set_defaults(func=cmd_evidence)
    done = sub.add_parser("done")
    done.add_argument("id")
    done.set_defaults(func=cmd_done)
    fail = sub.add_parser("fail")
    fail.add_argument("id")
    fail.add_argument("--kind", required=True)
    fail.add_argument("--record", required=True, help="错误、原运行和阶段报告的可追溯引用")
    fail.set_defaults(func=cmd_fail)
    reopen = sub.add_parser("reopen")
    reopen.add_argument("id")
    reopen.add_argument("--resolution", choices=["resumed", "terminated"], required=True)
    reopen.add_argument("--record", required=True, help="宿主原运行状态的可追溯依据")
    reopen.set_defaults(func=cmd_reopen)
    decide = sub.add_parser("decide")
    decide.add_argument("text")
    decide.add_argument("--why", required=True)
    decide.add_argument("--unit", default="run")
    decide.add_argument("--reversible", action="store_true")
    decide.set_defaults(func=cmd_decide)
    gate = sub.add_parser("gate")
    gate_sub = gate.add_subparsers(dest="gate_verb")
    gate_add = gate_sub.add_parser("add")
    gate_add.add_argument("text")
    gate_add.add_argument("--default", required=True)
    gate_add.add_argument("--unit")
    gate_add.set_defaults(func=cmd_gate)
    resolve = gate_sub.add_parser("resolve")
    resolve.add_argument("gate")
    answer = resolve.add_mutually_exclusive_group(required=True)
    answer.add_argument("--answer")
    answer.add_argument("--default", action="store_true")
    resolve.add_argument("--unit")
    resolve.set_defaults(func=cmd_gate_resolve)
    status = sub.add_parser("status")
    status.set_defaults(func=cmd_status)
    capsule = sub.add_parser("capsule")
    capsule.set_defaults(func=cmd_capsule)
    close = sub.add_parser("close")
    close.set_defaults(func=cmd_close)
    imp = sub.add_parser("import")
    imp.add_argument("task_id")
    imp.set_defaults(func=cmd_import)
    inspect = sub.add_parser("inspect")
    inspect.add_argument("--json", action="store_true")
    inspect.set_defaults(func=cmd_inspect)
    acceptance = sub.add_parser("acceptance")
    acceptance_sub = acceptance.add_subparsers(dest="acceptance_verb")
    acceptance_set = acceptance_sub.add_parser("set")
    acceptance_set.add_argument("id")
    acceptance_set.add_argument("statement")
    acceptance_set.add_argument("--source", required=True)
    acceptance_set.add_argument("--units", required=True)
    acceptance_set.set_defaults(func=cmd_acceptance_set)
    acceptance_list = acceptance_sub.add_parser("list")
    acceptance_list.add_argument("--json", action="store_true")
    acceptance_list.set_defaults(func=cmd_acceptance_list)
    acceptance_rebind = acceptance_sub.add_parser("rebind")
    acceptance_rebind.add_argument("id")
    acceptance_rebind.add_argument("--units", required=True)
    acceptance_rebind.set_defaults(func=cmd_acceptance_rebind)
    finish = sub.add_parser("finish")
    finish.set_defaults(func=cmd_finish)
    pause = sub.add_parser("pause")
    pause.add_argument("--reason", required=True)
    pause.add_argument("--record", required=True)
    pause.set_defaults(func=cmd_pause)
    resume = sub.add_parser("resume")
    resume.add_argument("--confirm", action="store_true")
    resume.add_argument("--take-ownership", dest="take_ownership", action="store_true")
    resume.add_argument("--record", default=None)
    init.add_argument("--session", default=None)
    init.set_defaults(func=cmd_init)
    resume.add_argument("--session", default=None)
    resume.set_defaults(func=cmd_resume)
    bind = sub.add_parser("bind")
    bind.add_argument("--session", required=True)
    bind.set_defaults(func=cmd_bind)
    host_event = sub.add_parser("event")
    host_event.add_argument("--record", required=True)
    host_event.set_defaults(func=cmd_event)
    receive = sub.add_parser("receive")
    receive.add_argument("id")
    receive.add_argument("--receipt", required=True)
    receive.add_argument("--record", required=True)
    receive.set_defaults(func=cmd_receive)
    op = sub.add_parser("op")
    op_sub = op.add_subparsers(dest="op_verb")
    reconcile = op_sub.add_parser("reconcile")
    reconcile.add_argument("op")
    reconcile.add_argument("--resolution", required=True)
    reconcile.add_argument("--record", required=True)
    reconcile.set_defaults(func=cmd_op_reconcile)
    return parser


def main(argv: list[str] | None = None) -> None:
    global EXPLICIT_RUN_ID, CALLER_SESSION, CALLER_GENERATION
    raw = list(sys.argv[1:] if argv is None else argv)
    repo = None
    explicit = None
    CALLER_SESSION = os.environ.get("PI_SESSION_ID") or os.environ.get("XR_SESSION") or None
    CALLER_GENERATION = None
    cleaned: list[str] = []
    index = 0
    while index < len(raw):
        if raw[index] in {"--session", "--generation"} and index + 1 < len(raw):
            flag, value = raw[index:index + 2]
            if flag == "--session":
                CALLER_SESSION = value
                if any(verb in raw for verb in ("bind", "resume", "init")):
                    cleaned.extend([flag, value])
            else:
                try:
                    CALLER_GENERATION = int(value)
                    if CALLER_GENERATION < 1:
                        raise ValueError("non-positive generation")
                except ValueError:
                    die("generation 必须为正整数")
            index += 2
            continue
        if raw[index] == "--offline":
            CALLER_SESSION = "local"
            if "init" in raw:
                cleaned.append("--offline")
            index += 1
            continue
        if raw[index] == "--repo" and index + 1 < len(raw):
            repo = raw[index + 1]
            index += 2
            continue
        if raw[index] == "--run-id":
            if explicit is not None or index + 1 >= len(raw) or raw[index + 1].startswith("-"):
                die("--run-id 重复或为空。正确命令：xr --run-id <id> status")
            explicit = raw[index + 1]
            index += 2
            continue
        cleaned.append(raw[index])
        index += 1
    EXPLICIT_RUN_ID = explicit
    if len(cleaned) >= 2 and cleaned[0] == "gate" and cleaned[1] not in {"add", "resolve"}:
        cleaned.insert(1, "add")
    parser = build()
    try:
        args = parser.parse_args(cleaned)
    except SystemExit as error:
        if error.code not in (0, None):
            die("参数不对。正确命令：xr init <slug> | xr plan add <id> \"标题\" --deps none --files <路径> --verify \"<命令>\" | xr next | xr verify <id> | xr done <id> | xr fail <id> --kind net --record <引用> | xr reopen <id> --resolution resumed|terminated --record <依据> | xr decide \"决定\" --why \"理由\" | xr gate add \"问题\" --default \"默认\" | xr gate resolve G1 --answer \"答案\" | xr close | xr status | xr capsule | xr import <task-id>")
        raise
    args.repo = repo
    if not getattr(args, "func", None):
        die("未知或不完整的命令。正确命令：xr init <slug> | xr plan add <id> \"标题\" --deps none --files <路径> --verify \"<命令>\" | xr next | xr verify <id> | xr done <id> | xr fail <id> --kind net --record <引用> | xr reopen <id> --resolution resumed|terminated --record <依据> | xr decide \"决定\" --why \"理由\" | xr gate add \"问题\" --default \"默认\" | xr gate resolve G1 --answer \"答案\" | xr close | xr status | xr capsule | xr import <task-id>")
    args.func(args)


if __name__ == "__main__":
    main()
